#

#
# Environment variables loaded for development, production and testing.
#

# The AWS region to deploy to.
#
AWS_REGION=eu-central-1

# The AWS named profile to use for deployment.
#
# Leave empty to use the default credential resolution of the aws and sam CLIs. Set this to deploy into a different AWS
# account without having to switch the active profile in your shell.
#
#AWS_PROFILE=

# Regular opening hours.
#
#HOURS=:0800/1200,1300/1700:0800/1200,1300/1700:0800/1200,1300/1700:0800/1200,1300/1700:0800/1200,1300/1700:

# Additional times where the service is available, outside of the normal opening hours.
#
#EXTRA_HOURS=

# Days where the normal opening hours don't apply.
#
#HOLIDAYS=

# Human-readable description for the opening hours.
#
#HOURS_DESCRIPTION="Montag bis Freitag von 8 bis 12 und von 13 bis 17 Uhr."

# Timezone to use for opening hours.
#
TZ=Europe/Berlin

# The from-address used for confirmation e-mails sent when a user adds or updates an e-mail address on their profile.
#
# Leave empty to disable e-mail sending. The deployment derives the sending domain from the address (everything
# after the @, ignoring any display name) and creates an SES identity for it. Either a bare address (addr@domain) or
# a 'Display Name <addr@domain>' form may be used.
#
#MAIL_FROM_ADDRESS="Tower <noreply@t.tower-assist.de>"

# Download link for the source code.
#
# If you make a modified version of this sofware,
# you must override this link in .env.local
# to point to a public repository
# hosting your modified code.
#
SOURCE_URL=https://github.com/valomedia/tower-backend
