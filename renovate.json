{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>valomedia/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\s+ARG AWS_SAM_CLI_VERSION=(?<currentValue>[^\\s]+)"
      ]
    }
  ]
}
