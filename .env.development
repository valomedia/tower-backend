#
# Environment variables loaded for development deployments.
#

# The AWS S3 bucket to use for deployment.
#
AWS_S3_BUCKET=tower-backend-dev

# The name for the AWS CloudFormation stack.
#
AWS_CLOUDFORMATION_STACK=tower-backend-dev

# The name for the AWS SAM stage to deploy.
#
AWS_SAM_STAGE_NAME=Dev

# The endpoint to check basic auth tokens against.
#
#AUTH_URL=https://auth.dev.tower-assist.de

# Value for the Access-Control-Allow-Origin CORS-header, if any.
#
#ALLOW_ORIGIN=

# The Azure Communication Services endpoint to use.
#
#AZ_COMMUNICATION_SERVICES_ENDPOINT=
